# Names only. Real values live in .env.local (not committed) and in the
# Vercel project's Environment Variables. Never commit a value here.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only

# Anthropic (report text)
ANTHROPIC_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Ads (only with consent)
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_CONVERSIONS_TOKEN=

# Email sent by Bearing itself (lib/server/email.ts): the saved-progress
# reminder and the account-deletion code. Server only.
RESEND_API_KEY=                     # Resend → API Keys, "Sending access" for the verified domain
EMAIL_FROM=                         # e.g. Bearing <hello@getbearing.me>

# Saved-progress job (app/api/cron/saved-progress). Vercel sends it as
# "Authorization: Bearer <CRON_SECRET>" on scheduled runs. Any long random string.
CRON_SECRET=
